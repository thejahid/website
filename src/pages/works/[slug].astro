---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandIcon from '../../components/BrandIcon.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/site';

export function getStaticPaths() { return projects.map(p => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props;
const others = projects.filter(x => x.slug !== p.slug).slice(0, 2);
---
<BaseLayout title={p.title} description={p.description}>
  <article class="pt-4">
    <a href="/works" class="text-sm text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-50">← All works</a>
    <div class="mt-5 overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800">
      {p.image
        ? <div class="aspect-[16/9] w-full bg-zinc-100 dark:bg-zinc-800/40">
            <div class="flex h-full flex-col overflow-hidden">
              <div class="flex h-6 shrink-0 items-center gap-1.5 bg-zinc-100 px-3 dark:bg-zinc-200">
                <span class="size-1.5 rounded-full bg-[#ff5f57]"></span><span class="size-1.5 rounded-full bg-[#febc2e]"></span><span class="size-1.5 rounded-full bg-[#28c840]"></span>
                {p.linkLabel && <span class="mx-auto max-w-[70%] truncate rounded bg-white px-2.5 py-px text-[8px] leading-3 text-zinc-400">{p.linkLabel}</span>}
              </div>
              <Image src={p.image} alt={`${p.title} preview`} width={1200} height={675} class="min-h-0 w-full flex-1 origin-top scale-[1.15] object-cover object-top" />
            </div>
          </div>
        : p.icon
        ? <div class:list={["relative flex aspect-[16/9] w-full items-center justify-center bg-gradient-to-br", p.gradient]}><span class="absolute top-6 left-6 text-[10px] font-medium tracking-wider text-white/70 uppercase sm:left-8">{p.year}</span><Image src={p.icon} alt={`${p.title} icon`} width={171} height={171} class="size-28 rounded-[24%] shadow-xl shadow-black/20 sm:size-36" /></div>
        : <div class:list={["flex aspect-[16/9] w-full flex-col justify-between bg-gradient-to-br p-6 sm:p-8", p.gradient]}><span class="text-[10px] font-medium tracking-wider text-white/70 uppercase">{p.year}</span><span><span class="block text-2xl font-bold tracking-tight text-white sm:text-3xl">{p.title}</span><span class="mt-1 block text-sm text-white/80">{p.tagline}</span></span></div>}
    </div>
    <h1 class="mt-8 text-2xl font-bold tracking-tight">{p.title}</h1>
    <p class="mt-1 text-zinc-500 dark:text-zinc-400">{p.tagline}</p>
    <dl class="mt-6 grid grid-cols-2 gap-4 rounded-2xl border border-zinc-200 bg-white p-5 text-sm dark:border-zinc-800 dark:bg-zinc-900/60 sm:grid-cols-3">
      <div><dt class="text-xs tracking-wider text-zinc-400 uppercase">Period</dt><dd class="mt-1 font-medium">{p.year}</dd></div>
      <div><dt class="text-xs tracking-wider text-zinc-400 uppercase">Role</dt><dd class="mt-1 font-medium">{p.role}</dd></div>
      <div>{p.href && <><dt class="text-xs tracking-wider text-zinc-400 uppercase">Visit</dt><dd class="mt-1"><a href={p.href} target="_blank" rel="noreferrer" class="font-medium underline decoration-zinc-300 underline-offset-4 hover:decoration-zinc-900 dark:decoration-zinc-600">{p.linkLabel} ↗</a></dd></>}</div>
    </dl>
    <p class="mt-6 text-[15px] leading-7 text-zinc-600 dark:text-zinc-400">{p.description}</p>
    <h2 class="mt-8 text-base font-semibold">Highlights</h2>
    <ul class="mt-3 list-disc space-y-2 pl-5 text-[15px] leading-7 text-zinc-600 dark:text-zinc-400">{p.highlights.map(h => <li>{h}</li>)}</ul>
    <div class="mt-6 flex flex-wrap gap-1.5">{p.stack.map(s => <span class="inline-flex items-center gap-1.5 rounded-full bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400"><BrandIcon name={s} class="size-3.5" />{s}</span>)}</div>
  </article>
  <section class="mt-14">
    <h2 class="mb-5 text-base font-semibold">More works</h2>
    <div class="grid gap-4 sm:grid-cols-2">{others.map(o => <ProjectCard project={o} />)}</div>
  </section>
</BaseLayout>
