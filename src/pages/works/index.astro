---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/site';
---
<BaseLayout title="Works" description="Selected work by Jahid Hasan: SolspaceAI, Craft Freeform, Craft Calendar, and headless commerce & CMS builds.">
  <section class="pt-4">
    <h1 class="text-2xl font-bold tracking-tight">Works</h1>
    <p class="mt-2 text-[15px] leading-7 text-zinc-500 dark:text-zinc-400">AI platforms, SaaS products, plugins used on 10,000+ sites, and a decade of headless builds, from Craft CMS and Sanity to Shopify.</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">{projects.map(p => <ProjectCard project={p} />)}</div>
  </section>
</BaseLayout>
