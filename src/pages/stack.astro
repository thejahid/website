---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandIcon from '../components/BrandIcon.astro';
import { stackGroups } from '../data/site';
---
<BaseLayout title="Tech Stack" description="Tech stack of Jahid Hasan: AI/LLM tooling, TypeScript, React, Next.js, Astro, Python, FastAPI, AWS and headless CMS platforms.">
  <section class="pt-4">
    <h1 class="text-2xl font-bold tracking-tight">Tech Stack</h1>
    <p class="mt-2 text-[15px] leading-7 text-zinc-500 dark:text-zinc-400">The tools I reach for to ship complete products, from the model layer to the interface people actually use.</p>
    <div class="mt-8 space-y-4">
      {stackGroups.map(g => (
        <section class="rounded-2xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900/60">
          <h2 class="text-sm font-semibold tracking-tight">{g.label}</h2>
          <div class="mt-3 flex flex-wrap gap-2">{g.items.map(item => <span class="inline-flex items-center gap-2 rounded-full bg-zinc-100 px-3 py-1.5 text-sm font-medium text-zinc-600 transition hover:bg-zinc-900 hover:text-white dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-white dark:hover:text-zinc-900"><BrandIcon name={item} class="size-4" />{item}</span>)}</div>
        </section>
      ))}
    </div>
    <p class="mt-6 rounded-2xl bg-zinc-900 p-5 text-sm leading-6 text-zinc-300 dark:bg-white dark:text-zinc-600">This site itself: <strong class="text-white dark:text-zinc-900">Astro 5 + Tailwind CSS 4 + TypeScript</strong>, Markdown content collections and a sitemap, statically built with pnpm for near-zero JavaScript and fast loads anywhere.</p>
  </section>
</BaseLayout>
