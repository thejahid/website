---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found">
  <section class="pt-16 text-center">
    <p class="text-sm font-medium text-zinc-400">404</p>
    <h1 class="mt-2 text-2xl font-bold tracking-tight">This page took a wrong turn</h1>
    <p class="mt-2 text-zinc-500 dark:text-zinc-400">The page you're looking for doesn't exist, but plenty of good stuff does.</p>
    <a href="/" class="mt-6 inline-block rounded-full bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-white dark:bg-white dark:text-zinc-900">Back home</a>
  </section>
</BaseLayout>
