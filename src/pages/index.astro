---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Heatmap from '../components/Heatmap.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BrandIcon from '../components/BrandIcon.astro';
import OrgMark from '../components/OrgMark.astro';
import avatar from '../assets/avatar.jpg';
import { site, socials, projects, journey, stackPreview, reviews } from '../data/site';

const featured = projects.filter(p => p.featured);
const journeyPreview = journey.slice(0, 3);
---
<BaseLayout>
  <!-- Hero -->
  <section class="rise pt-4">
    <div class="flex items-center gap-4">
      <Image src={avatar} alt="Jahid Hasan" width={160} height={160} class="size-20 rounded-2xl object-cover ring-1 ring-zinc-200 dark:ring-zinc-800" loading="eager" />
      <div>
        <h1 class="shimmer-name text-xl font-bold tracking-tight sm:text-2xl">{site.name}</h1>
        <p class="text-sm text-zinc-500 dark:text-zinc-400">{site.employer}</p>
      </div>
    </div>
    <p class="mt-6 text-[15px] leading-7 text-zinc-600 dark:text-zinc-400">👋 {site.intro}</p>
    <p class="mt-3 text-[15px] leading-7 text-zinc-600 dark:text-zinc-400">You can find me building on <a class="font-medium text-zinc-900 underline decoration-zinc-300 underline-offset-4 hover:decoration-zinc-900 dark:text-zinc-50 dark:decoration-zinc-600" href="https://github.com/thejahid" target="_blank" rel="noreferrer">GitHub</a>, connecting on <a class="font-medium text-zinc-900 underline decoration-zinc-300 underline-offset-4 hover:decoration-zinc-900 dark:text-zinc-50 dark:decoration-zinc-600" href="https://www.linkedin.com/in/inthejahid" target="_blank" rel="noreferrer">LinkedIn</a>.</p>

    <div class="mt-6 grid gap-3 sm:grid-cols-3">
      {socials.map(s => (
        <a href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer" class="group rounded-2xl border border-zinc-200 bg-white p-4 transition hover:-translate-y-0.5 hover:shadow-md dark:border-zinc-800 dark:bg-zinc-900/60">
          <span class="flex items-center justify-between text-sm font-semibold"><span class="flex items-center gap-2"><BrandIcon name={s.label} class="size-4" />{s.label}</span><span class="text-zinc-300 transition group-hover:translate-x-0.5 group-hover:text-zinc-900 dark:text-zinc-600 dark:group-hover:text-zinc-50">↗</span></span>
          <span class="mt-0.5 block truncate text-xs font-medium text-zinc-400">{s.handle}</span>
          <span class="mt-2 block text-xs leading-5 text-zinc-500 dark:text-zinc-400">{s.description}</span>
        </a>
      ))}
    </div>
    <div class="mt-3"><Heatmap /></div>
  </section>

  <!-- Journey -->
  <section class="rise rise-1 mt-14">
    <Section title="Journey" href="/journey" />
    <ul class="divide-y divide-zinc-200 rounded-2xl border border-zinc-200 bg-white dark:divide-zinc-800 dark:border-zinc-800 dark:bg-zinc-900/60">
      {journeyPreview.map(j => (
        <li class="flex gap-4 p-4">
          <OrgMark org={j.org} />
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-baseline justify-between gap-2"><p class="text-sm font-semibold">{j.role}</p><span class="text-xs text-zinc-400">{j.period}</span></div>
            <p class="text-sm text-zinc-500 dark:text-zinc-400">{j.org} · {j.place}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- Works -->
  <section class="rise rise-2 mt-14">
    <Section title="Works" href="/works" />
    <div class="grid gap-4 sm:grid-cols-2">{featured.map(p => <ProjectCard project={p} />)}</div>
  </section>

  <!-- Reviews -->
  <section class="mt-14">
    <Section title="Reviews" />
    {reviews.filter(r => r.featured).map(r => (
      <figure class="rounded-2xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900/60">
        <svg class="size-6 text-zinc-300 dark:text-zinc-600" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10 7H6a4 4 0 0 0-4 4v6h7v-7H6.5A2.5 2.5 0 0 1 9 7.6V7h1zm12 0h-4a4 4 0 0 0-4 4v6h7v-7h-2.5A2.5 2.5 0 0 1 21 7.6V7h1z"/></svg>
        <blockquote class="mt-3 text-[15px] leading-7 text-zinc-700 dark:text-zinc-300">{r.text}</blockquote>
        <figcaption class="mt-5 flex items-center gap-3">
          <Image src={r.photo} alt={r.name} width={96} height={96} class="size-11 rounded-full object-cover ring-1 ring-zinc-200 dark:ring-zinc-700" loading="lazy" />
          <span><span class="block text-sm font-semibold">{r.name}</span><span class="block text-xs text-zinc-400">{r.role} · {r.meta}</span></span>
          <span class="ml-auto hidden shrink-0 items-center gap-1.5 text-xs font-medium text-zinc-400 sm:inline-flex"><BrandIcon name="LinkedIn" class="size-3.5" />LinkedIn</span>
        </figcaption>
      </figure>
    ))}
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      {reviews.filter(r => !r.featured).map(r => (
        <figure class="flex flex-col rounded-2xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900/60">
          <blockquote class="flex-1 text-sm leading-6 text-zinc-600 dark:text-zinc-400">"{r.text}"</blockquote>
          <figcaption class="mt-4 flex items-center gap-3 border-t border-zinc-100 pt-4 dark:border-zinc-800">
            <Image src={r.photo} alt={r.name} width={96} height={96} class="size-10 rounded-full object-cover ring-1 ring-zinc-200 dark:ring-zinc-700" loading="lazy" />
            <span class="min-w-0"><span class="block truncate text-sm font-semibold">{r.name}</span><span class="block truncate text-[11px] text-zinc-400">{r.role}</span><span class="block text-[11px] text-zinc-400">{r.meta}</span></span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- Stack -->
  <section class="mt-14">
    <Section title="Tech Stack" href="/stack" />
    <div class="flex flex-wrap gap-2">{stackPreview.map(s => <span class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900/60 dark:text-zinc-300"><BrandIcon name={s} class="size-4" />{s}</span>)}</div>
  </section>

</BaseLayout>
