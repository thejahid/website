---
import BrandIcon from './BrandIcon.astro';
import { site, socials } from '../data/site';
---
<footer class="border-t border-zinc-200 dark:border-zinc-800">
  <div class="mx-auto w-full max-w-2xl px-5 py-10 sm:px-6">
    <div class="flex flex-wrap items-start justify-between gap-6">
      <div>
        <p class="text-sm font-semibold">{site.name}</p>
        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{site.role}</p>
        <a href={`mailto:${site.email}`} class="mt-3 inline-block text-sm font-medium underline decoration-zinc-300 underline-offset-4 hover:decoration-zinc-900 dark:decoration-zinc-600 dark:hover:decoration-zinc-100">{site.email}</a>
      </div>
      <nav class="flex gap-8 text-sm" aria-label="Footer">
        <div class="flex flex-col gap-2">
          <span class="text-xs font-medium tracking-wider text-zinc-400 uppercase">Pages</span>
          <a class="text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-50" href="/works">Works</a>
          <a class="text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-50" href="/journey">Journey</a>
          <a class="text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-50" href="/stack">Stack</a>
        </div>
        <div class="flex flex-col gap-2">
          <span class="text-xs font-medium tracking-wider text-zinc-400 uppercase">Elsewhere</span>
          {socials.map(s => <a class="inline-flex items-center gap-1.5 text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-50" href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer"><BrandIcon name={s.label} class="size-3.5" />{s.label}</a>)}
        </div>
      </nav>
    </div>
    <div class="mt-10 flex flex-wrap items-center justify-between gap-3 text-xs text-zinc-400">
      <p>© {new Date().getFullYear()} {site.name}. Built with Astro & Tailwind CSS.</p>
      <div class="flex items-center gap-4">
        <button type="button" aria-label="Toggle theme" class="theme-toggle inline-flex items-center gap-1.5 transition hover:text-zinc-900 dark:hover:text-zinc-50">
          <svg class="size-3.5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
          <svg class="hidden size-3.5 dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
          <span class="dark:hidden">Dark</span><span class="hidden dark:inline">Light</span>
        </button>
        <a href="#top" onclick="window.scrollTo({top:0,behavior:'smooth'});return false;" class="hover:text-zinc-900 dark:hover:text-zinc-50">Back to top ↑</a>
      </div>
    </div>
  </div>
</footer>
<script>
  const applyTheme = () => {
    const stored = localStorage.getItem('theme');
    const dark = stored === 'dark' || (!stored && matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.classList.toggle('dark', dark);
  };
  const toggleTheme = () => {
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  };
  const bindTheme = () => document.querySelectorAll('.theme-toggle').forEach(btn => {
    btn.removeEventListener('click', toggleTheme);
    btn.addEventListener('click', toggleTheme);
  });
  // View transitions replace <html> with the incoming page's attributes, and
  // that page's inline theme script never runs, so the dark class would be
  // lost on every navigation. Carry the current theme onto the new document
  // before the swap, then re-apply and re-bind after it.
  document.addEventListener('astro:before-swap', (event) => {
    const newDocument = (event as { newDocument: Document }).newDocument;
    newDocument.documentElement.classList.toggle('dark', document.documentElement.classList.contains('dark'));
  });
  document.addEventListener('astro:after-swap', () => { applyTheme(); bindTheme(); });
  bindTheme();
</script>
