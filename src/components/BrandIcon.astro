---
import { brandIcons, DARK_HEX } from '../data/icons';
interface Props { name: string; class?: string; }
const { name, class: cls = 'size-4' } = Astro.props;
const icon = brandIcons[name];
const fill = icon ? (DARK_HEX.has(icon.hex.toUpperCase()) ? 'currentColor' : `#${icon.hex}`) : null;

// No real brand logo exists for this item: generate a small abstract
// geometric mark from the name (same name always gets the same mark).
// It is decorative only and does not imitate any real brand.
const palette = ['#6366f1', '#ec4899', '#f59e0b', '#10b981', '#3b82f6', '#8b5cf6', '#ef4444', '#14b8a6', '#f97316', '#06b6d4'];
let hash = 0;
for (let i = 0; i < name.length; i++) hash = (hash * 31 + name.charCodeAt(i)) >>> 0;
const c1 = palette[hash % palette.length];
const c2 = palette[Math.floor(hash / palette.length) % palette.length];
const variant = hash % 5;
---
{icon ? (
  <svg class:list={[cls, 'shrink-0']} viewBox={icon.viewBox ?? '0 0 24 24'} fill={fill} aria-hidden="true">{icon.letter && <text x="12" y="14.5" text-anchor="middle" font-size="13" font-weight="700" font-family="Arial, sans-serif" fill={fill}>{icon.letter}</text>}<path d={icon.path} /></svg>
) : (
  <svg class:list={[cls, 'shrink-0']} viewBox="0 0 24 24" aria-hidden="true">
    {variant === 0 && <><circle cx="9" cy="9" r="6" fill={c1} /><circle cx="16.5" cy="16.5" r="4.5" fill={c2} opacity="0.85" /></>}
    {variant === 1 && <><rect x="3" y="3" width="12" height="12" rx="3" fill={c1} /><circle cx="16.5" cy="16.5" r="4.5" fill={c2} opacity="0.85" /></>}
    {variant === 2 && <><path d="M12 3l9 17H3z" fill={c1} /><circle cx="12" cy="15" r="3.2" fill={c2} opacity="0.9" /></>}
    {variant === 3 && <><rect x="4" y="4" width="16" height="16" rx="8" fill="none" stroke={c1} stroke-width="3" /><circle cx="12" cy="12" r="3.4" fill={c2} /></>}
    {variant === 4 && <><path d="M12 2l8 5v10l-8 5-8-5V7z" fill={c1} /><path d="M12 7l4 2.5v5L12 17l-4-2.5v-5z" fill={c2} opacity="0.85" /></>}
  </svg>
)}
