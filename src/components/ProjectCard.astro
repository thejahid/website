---
import { Image } from 'astro:assets';
import BrandIcon from './BrandIcon.astro';
import type { Project } from '../data/site';
interface Props { project: Project; }
const { project: p } = Astro.props;
---
<a href={`/works/${p.slug}`} class="group block overflow-hidden rounded-2xl border border-zinc-200 bg-white transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-zinc-900/5 dark:border-zinc-800 dark:bg-zinc-900/60 dark:hover:shadow-black/30">
  {p.image
    ? <div class="aspect-[16/9] w-full bg-zinc-100 dark:bg-zinc-800/40">
        <div class="flex h-full flex-col overflow-hidden">
          <div class="flex h-[18px] shrink-0 items-center gap-1 bg-zinc-100 px-2 dark:bg-zinc-200">
            <span class="size-1 rounded-full bg-[#ff5f57]"></span><span class="size-1 rounded-full bg-[#febc2e]"></span><span class="size-1 rounded-full bg-[#28c840]"></span>
            {p.linkLabel && <span class="mx-auto max-w-[70%] truncate rounded-sm bg-white px-1.5 py-px text-[7px] leading-[10px] text-zinc-400">{p.linkLabel}</span>}
          </div>
          <Image src={p.image} alt={`${p.title} preview`} width={800} height={450} class="min-h-0 w-full flex-1 origin-top scale-[1.35] object-cover object-top" loading="lazy" />
        </div>
      </div>
    : p.icon
    ? <div class:list={["relative flex aspect-[16/9] w-full items-center justify-center bg-gradient-to-br", p.gradient]}>
        <span class="absolute top-4 left-4 text-[10px] font-medium tracking-wider text-white/70 uppercase">{p.year}</span>
        <Image src={p.icon} alt={`${p.title} icon`} width={171} height={171} class="size-24 rounded-[24%] shadow-xl shadow-black/20 transition group-hover:scale-105 sm:size-28" loading="lazy" />
      </div>
    : <div class:list={["flex aspect-[16/9] w-full flex-col justify-between bg-gradient-to-br p-5", p.gradient]}>
        <span class="text-[10px] font-medium tracking-wider text-white/70 uppercase">{p.year}</span>
        <span><span class="block text-lg font-bold tracking-tight text-white">{p.title}</span><span class="mt-1 block text-xs text-white/80">{p.tagline}</span></span>
      </div>}
  <div class="p-5">
    <h3 class="text-[15px] leading-snug font-semibold tracking-tight group-hover:underline group-hover:underline-offset-4">{p.title}</h3>
    {p.linkLabel && <p class="mt-0.5 truncate text-[10px] tracking-wide text-zinc-400">{p.linkLabel} ↗</p>}
    <p class="mt-1.5 text-sm text-zinc-500 dark:text-zinc-400">{p.tagline}</p>
    <div class="mt-3 flex flex-wrap gap-1.5">{p.stack.slice(0, 4).map(s => <span class="inline-flex items-center gap-1.5 rounded-full bg-zinc-100 px-2 py-0.5 text-[11px] font-medium text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400"><BrandIcon name={s} class="size-3" />{s}</span>)}</div>
  </div>
</a>
