{
  // Cloudflare Workers static assets: serve the Astro build in dist/
  "name": "website",
  "compatibility_date": "2026-10-01",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
